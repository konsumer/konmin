    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,30 h8 v48 h-8 z" />
    <!-- upper diagonal -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M69.5,44.2 l5.7,5.7 -20.5,20.5 -5.7,-5.7 z" />
    <!-- lower diagonal -->
